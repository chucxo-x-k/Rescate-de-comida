PORT=3000
NODE_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=chucxo_x_k
DB_NAME=rescate_comida

# Sesiones (JWT). Cambia el secreto por una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRA_HORAS=12

# Almacenamiento de fotos, firmas y documentos: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=uploads
# Solo si STORAGE_DRIVER=s3 (requiere: npm install @aws-sdk/client-s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_URL_PUBLICA=

# Tarea programada de alertas de caducidad (CU 11)
TAREAS_PROGRAMADAS=true