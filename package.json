{
  "name": "rescate-comida",
  "version": "1.0.0",
  "description": "Plataforma que conecta donantes de alimentos, comedores comunitarios y voluntarios de transporte para rescatar comida antes de que caduque.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test tests/unit/dominio.test.js tests/unit/comercializacion.test.js",
    "test:e2e": "node --test tests/e2e/flujo-completo.test.js"
  },
  "keywords": [
    "rescate",
    "comida",
    "donaciones",
    "logistica"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  }
}
