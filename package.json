{
  "name": "rescate-comida",
  "version": "1.0.0",
  "description": "Plataforma que conecta donantes de alimentos, comedores comunitarios y voluntarios de transporte para rescatar comida antes de que caduque.",
  "main": "servidor/iniciarServidor.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node servidor/iniciarServidor.js",
    "dev": "node --watch servidor/iniciarServidor.js",
    "db:init": "node comandos/crearBaseDeDatos.js",
    "seed:demo": "node comandos/cargarDatosDemo.js",
    "test": "node --test pruebas/unitarias/modelos.prueba.js pruebas/unitarias/bloqueoComercializacion.prueba.js",
    "test:e2e": "node --test pruebas/integracion/flujoCompleto.prueba.js"
  },
  "keywords": [
    "rescate",
    "comida",
    "donaciones",
    "logistica"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  }
}
